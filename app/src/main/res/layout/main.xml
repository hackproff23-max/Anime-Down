<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E0E14"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:paddingTop="6dp">

            <EditText
                android:id="@+id/url"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_url"
                android:hint="Buscar ou colar link"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingRight="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A90"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnGo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ir"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_go" />

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favoritos e histórico"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star" />

            <ImageButton
                android:id="@+id/btnDirect"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Baixar"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download" />

            <ImageButton
                android:id="@+id/btnList"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Meus downloads"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="invisible" />

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/activeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1B28"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/activeProg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <TextView
                android:id="@+id/activeTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFound"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_found"
            android:drawableLeft="@drawable/ic_download"
            android:drawablePadding="8dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
